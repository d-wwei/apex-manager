{
  "name": "apex-manager",
  "version": "0.1.1",
  "type": "module",
  "os": ["darwin", "linux"],
  "bin": {
    "apex-manager": "bin/apex-manager.sh"
  },
  "files": [
    "bin/",
    "src/",
    "skills/Money-Come-To-Eli/",
    "docs/reference/",
    "README.md",
    "README.zh.md",
    "SKILL.md",
    "CHANGELOG.md",
    "install.sh"
  ],
  "scripts": {
    "dev": "npx tsx src/cli.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run typecheck && npm test"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
